{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["typescript/src/**/*.ts", "javascript/src/**/*.mjs"],
  "typeAcquisition": { "enable": false }
}
