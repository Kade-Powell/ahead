[Desktop Entry]
Version=1.0
Type=Application

Name=AHEAD
Comment=AI-native code editor with streamed voice, contextual predictions, and collaboration
Categories=Development;IDE;
GenericName=Code Editor
StartupWMClass=ahead

Icon=io.ahead.ahead
Exec=ahead %F
Terminal=false
MimeType=text/plain;inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=ahead --new %F
Icon=io.ahead.ahead
